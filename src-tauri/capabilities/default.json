{
  "$schema": "https://schema.tauri.app/config/capability",
  "identifier": "default",
  "description": "Capability for default window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "opener:default"
  ]
}
